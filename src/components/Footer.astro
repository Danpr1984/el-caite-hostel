---
interface Props {
  lang: "es" | "en";
}
const { lang } = Astro.props;

const t = {
  es: {
    tagline: "Tu basecamp en San Juan del Sur.",
    links: [
      { href: "#hostel", label: "El Hostel" },
      { href: "#habitaciones", label: "Habitaciones" },
      { href: "#amenidades", label: "Amenidades" },
      { href: "#ubicacion", label: "Ubicación" },
    ],
    contactLabel: "Contacto",
    whatsapp: "WhatsApp",
    rights: "Todos los derechos reservados.",
  },
  en: {
    tagline: "Your basecamp in San Juan del Sur.",
    links: [
      { href: "#hostel", label: "The Hostel" },
      { href: "#rooms", label: "Rooms" },
      { href: "#amenities", label: "Amenities" },
      { href: "#location", label: "Location" },
    ],
    contactLabel: "Contact",
    whatsapp: "WhatsApp",
    rights: "All rights reserved.",
  },
}[lang];
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-logo">El Caite Hostel</p>
      <p class="footer-tagline">{t.tagline}</p>
    </div>
    <nav class="footer-links">
      {t.links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <div class="footer-contact">
      <span class="section-label">{t.contactLabel}</span>
      <a href="https://wa.me/50500000000" target="_blank" rel="noopener">{t.whatsapp}: +505 0000 0000</a>
      <a href="mailto:hola@elcaitehostel.com">hola@elcaitehostel.com</a>
    </div>
  </div>
  <div class="footer-bottom container">
    <span>© {new Date().getFullYear()} El Caite Hostel. {t.rights}</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-sand);
    border-top: 1px solid var(--border);
    padding-top: 64px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 48px;
  }
  .footer-logo {
    font-family: 'Bricolage Grotesque', 'Work Sans', sans-serif;
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .footer-tagline { color: var(--muted); font-size: 0.92rem; max-width: 32ch; }
  .footer-links { display: flex; flex-direction: column; gap: 10px; }
  .footer-links a, .footer-contact a {
    font-size: 0.9rem; color: var(--muted); transition: color 0.2s;
  }
  .footer-links a:hover, .footer-contact a:hover { color: var(--pop-dk); }
  .footer-contact { display: flex; flex-direction: column; gap: 10px; }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding: 20px 32px 28px;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .footer-inner { grid-template-columns: 1fr; gap: 28px; }
    .footer-bottom { flex-direction: column; }
  }
</style>
