---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Carousel from "../components/Carousel.astro";
import Icon from "../components/Icon.astro";

/* =========================================================
   CONTENIDO EDITABLE — cambia aquí los textos y números.
   No necesitas tocar el HTML de abajo para actualizar el sitio.
   Todo el texto marcado [pendiente confirmar] es un placeholder.
   ========================================================= */
const content = {
  hero: {
    title: "Tu Hostel en el corazón de San Juan del Sur",
    subtitle: "San Juan del Sur, Nicaragua",
    cta: "Reservar",
    ctaSecondary: "Conoce el hostel",
  },
  intro: {
    stats: [
      { value: "8", label: "Habitaciones en total" },
      { value: "3 min", label: "Caminando a la playa" },
      { value: "2009", label: "Operando desde" },
      { value: "24h", label: "Recepción" },
    ],
  },
  split: {
    label: "El Hostel",
    heading: "Un lugar para conocer gente y descansar bien",
    text: "Ubicado en el malecón de San Juan del Sur, a solo 3 minutos caminando de la playa y el puerto, El Caite Hostel es un punto de encuentro para viajeros que buscan surf, comunidad y buena energía. Terraza, wifi gratuito y un equipo listo para ayudarte a armar tu itinerario.",
    images: [
      "/images/caite/about-1.jpg",
      "/images/caite/san-juan-2.jpg",
      "/images/caite/ikal-1.jpg",
      "/images/caite/ikal-2.jpg",
    ],
  },
  rooms: {
    label: "Habitaciones",
    heading: "Habitaciones y Espacios Comunes",
    text: "Todas nuestras habitaciones son privadas, con baño propio. Estas son fotos reales del hostel, para que sepas exactamente qué esperar.",
    features: ["Baño privado", "Aire acondicionado", "Habitaciones sin humo", "Ambiente familiar"],
    images: [
      "/images/caite/room-dorm-1.jpg",
      "/images/caite/room-private-1.jpg",
      "/images/caite/room-dorm-2.jpg",
      "/images/caite/room-common-2.jpg",
      "/images/caite/room-private-2.jpg",
      "/images/caite/room-dorm-3.jpg",
      "/images/caite/room-common-1.jpg",
    ],
  },
  amenities: {
    label: "Amenidades",
    heading: "El Caite Hostel incluye",
    items: [
      { icon: "wifi", title: "Wifi gratis", desc: "En todas las habitaciones y áreas comunes." },
      { icon: "car", title: "Traslado al aeropuerto", desc: "Coordina tu llegada con nosotros." },
      { icon: "utensils", title: "Restaurante", desc: "Comidas disponibles en la propiedad." },
      { icon: "ban", title: "Habitaciones sin humo", desc: "Todo el hostel es libre de humo." },
      { icon: "users", title: "Habitaciones familiares", desc: "Espacio pensado para grupos y familias." },
      { icon: "bell", title: "Servicio de habitaciones", desc: "Atención cuando la necesites." },
      { icon: "martini", title: "Bar", desc: "Bebidas y buen ambiente." },
      { icon: "coffee", title: "Desayuno", desc: "Empieza el día con energía." },
    ],
  },
  ikal: {
    label: "Recomendado",
    heading: "Ikal Resto-Bar",
    text: "Del mismo equipo detrás de El Caite Hostel — comparten el mismo espacio. El lugar ideal para tomar algo y comer bien después de un día de playa.",
    images: ["/images/caite/ikal-1.jpg", "/images/caite/ikal-2.jpg", "/images/caite/ikal-food-1.jpg", "/images/caite/ikal-food-2.jpg", "/images/caite/ikal-food-3.jpg"],
  },
  location: {
    label: "Ubicación",
    heading: "Cerca de todo lo importante",
    pills: [
      { icon: "waves", label: "Playa de San Juan del Sur — 3 min caminando" },
      { icon: "map-pin", label: "Puerto de San Juan del Sur — 3 min caminando" },
      { icon: "utensils", label: "Restaurantes (Ikal, Josseline's, El Timón) — a pasos" },
      { icon: "compass", label: "Playas de surf (El Remanso, Nacascolo) — 10 km" },
    ],
  },
  rules: {
    label: "Reglas del Hostel",
    heading: "Para una buena estadía",
    items: [
      "Check-in: desde las 2:00 pm — Check-out: antes de las 12:00 pm",
      "Check-in anticipado o fuera de horario (12:30 pm–10:30 pm): sujeto a disponibilidad y cargo adicional",
      "Check-out extendido: sujeto a disponibilidad, cargo de USD 5",
      "Cama extra: USD 10 por noche",
      "La persona que hace el check-in debe ser mayor de 18 años",
      "No se aceptan mascotas",
      "Prohibido fumar en toda la propiedad",
      "Estadía mínima: 1 noche",
    ],
    contactText: "¿Dudas antes de reservar? Escríbenos por WhatsApp.",
    whatsappNumber: "+505 0000 0000",
    whatsappLink: "https://wa.me/50500000000",
  },
  ctaSection: {
    heading: "Tu próxima aventura empieza en El Caite",
    reserveButton: "Reservar",
    whatsappButton: "WhatsApp",
  },
};

const roomsVisibleCount = 5;
const roomsExtraCount = Math.max(0, content.rooms.images.length - roomsVisibleCount);
---

<BaseLayout
  title="El Caite Hostel — San Juan del Sur"
  description="El Caite Hostel: tu basecamp en San Juan del Sur, Nicaragua. Habitaciones familiares, privadas y espacios comunes a pasos de la playa."
  lang="es"
>
  <Nav lang="es" />

  <!-- HERO -->
  <section class="hero">
    <img src="/images/caite/hero.jpg" alt="El Caite Hostel" class="hero-img" />
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <span class="hero-location">{content.hero.subtitle}</span>
      <h1>{content.hero.title}</h1>
      <div class="hero-buttons">
        <a href="#reservar" class="btn btn-white">{content.hero.cta}</a>
        <a href="#hostel" class="btn btn-outline">{content.hero.ctaSecondary}</a>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="intro">
    <div class="intro-stats container">
      {content.intro.stats.map((s) => (
        <div class="stat">
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- SPLIT -->
  <section class="split" id="hostel">
    <div class="container split-inner">
      <div class="split-text">
        <span class="section-label">{content.split.label}</span>
        <h2>{content.split.heading}</h2>
        <p>{content.split.text}</p>
      </div>
      <div class="split-carousel">
        <Carousel images={content.split.images} id="carousel-hostel" alt="El Caite Hostel" aspectRatio="4/3" />
      </div>
    </div>
  </section>

  <!-- ROOMS -->
  <section class="rooms" id="habitaciones">
    <div class="container">
      <span class="section-label">{content.rooms.label}</span>
      <h2 class="rooms-heading">{content.rooms.heading}</h2>
      <p class="rooms-text">{content.rooms.text}</p>
      <ul class="rooms-features">
        {content.rooms.features.map((item) => (
          <li><Icon name="check" size={15} />{item}</li>
        ))}
      </ul>
      <div class="rooms-gallery" data-images={JSON.stringify(content.rooms.images)}>
        {content.rooms.images.slice(0, roomsVisibleCount).map((src, i) => (
          <div class="gallery-item" data-index={i}>
            <img src={src} alt={`Habitaciones y espacios comunes El Caite Hostel ${i + 1}`} loading="lazy" />
            {i === roomsVisibleCount - 1 && roomsExtraCount > 0 && (
              <div class="gallery-more-overlay">+{roomsExtraCount} fotos</div>
            )}
          </div>
        ))}
      </div>
      <div class="rooms-cta">
        <a href="#reservar" class="btn btn-primary">Ver disponibilidad</a>
      </div>
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div class="lightbox" id="rooms-lightbox">
    <button class="lightbox-close" type="button" aria-label="Cerrar">&times;</button>
    <button class="lightbox-prev" type="button" aria-label="Anterior">&#8249;</button>
    <button class="lightbox-next" type="button" aria-label="Siguiente">&#8250;</button>
    <img src="" alt="" />
  </div>

  <!-- AMENITIES -->
  <section class="amenities" id="amenidades">
    <div class="container">
      <span class="section-label">{content.amenities.label}</span>
      <h2 class="amenities-heading">{content.amenities.heading}</h2>
      <div class="amenities-grid">
        {content.amenities.items.map((item) => (
          <div class="amenity">
            <span class="amenity-icon"><Icon name={item.icon} size={26} /></span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="location" id="ubicacion">
    <div class="container">
      <span class="section-label">{content.location.label}</span>
      <h2 class="location-heading">{content.location.heading}</h2>
      <div class="location-pills">
        {content.location.pills.map((pill) => (
          <span class="pill"><Icon name={pill.icon} size={18} />{pill.label}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- IKAL RESTO-BAR -->
  <section class="ikal-section">
    <div class="container">
      <div class="ikal-card">
        <div class="ikal-image">
          <Carousel images={content.ikal.images} id="carousel-ikal" alt={content.ikal.heading} aspectRatio="4/5" />
        </div>
        <div class="ikal-text">
          <span class="section-label">{content.ikal.label}</span>
          <h2>{content.ikal.heading}</h2>
          <p>{content.ikal.text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOUSE RULES -->
  <section class="rules container">
    <span class="section-label">{content.rules.label}</span>
    <h2 class="rules-heading">{content.rules.heading}</h2>
    <ul class="rules-list">
      {content.rules.items.map((rule) => (
        <li>{rule}</li>
      ))}
    </ul>
    <p class="rules-contact">
      {content.rules.contactText}
      <a href={content.rules.whatsappLink} target="_blank" rel="noopener" class="rules-whatsapp">
        {content.rules.whatsappNumber}
      </a>
    </p>
    <a href="#reservar" class="btn btn-primary rules-cta">Quiero Reservar</a>
  </section>

  <!-- CTA -->
  <section class="cta-section" id="reservar">
    <img src="/images/caite/cta-bg.jpg" alt="" class="cta-bg" loading="lazy" />
    <div class="cta-overlay"></div>
    <div class="cta-content container">
      <h2>{content.ctaSection.heading}</h2>
      <div class="cta-buttons">
        <a href={content.rules.whatsappLink} target="_blank" rel="noopener" class="btn btn-white">
          {content.ctaSection.reserveButton}
        </a>
        <a href={content.rules.whatsappLink} target="_blank" rel="noopener" class="btn btn-outline">
          {content.ctaSection.whatsappButton}
        </a>
      </div>
    </div>
  </section>

  <Footer lang="es" />
</BaseLayout>

<style>
  /* HERO */
  .hero { position: relative; height: 100svh; min-height: 560px; max-height: 960px; overflow: hidden; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(20,20,18,0.72) 0%, rgba(20,20,18,0.30) 42%, rgba(20,20,18,0.05) 70%);
  }
  .hero-content {
    position: relative; z-index: 2;
    height: 100%;
    display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end;
    text-align: left; color: var(--white);
    padding-bottom: 72px;
  }
  .hero-location {
    font-family: 'Work Sans', sans-serif;
    font-size: 0.85rem; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--white);
    opacity: 0.9;
    margin-bottom: 14px;
  }
  .hero-content h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); margin: 0 0 26px; max-width: 14ch; }
  .hero-buttons { display: flex; gap: 14px; flex-wrap: wrap; justify-content: flex-start; }

  /* INTRO */
  .intro { padding: 72px 0; background: var(--terracotta); }
  .intro-stats { display: flex; justify-content: center; flex-wrap: wrap; }
  .stat {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: 0 56px; border-left: 1px solid rgba(255,255,255,0.25);
  }
  .stat:first-child { border-left: none; }
  .stat-value { font-family: 'Bricolage Grotesque', 'Work Sans', sans-serif; font-size: 3rem; font-weight: 700; color: var(--white); }
  .stat-label { font-size: 0.9rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--bg-sand); opacity: 0.85; }

  /* SPLIT */
  .split { background: var(--white); padding: 96px 0; }
  .split-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .split-text h2 { font-size: 2.2rem; margin: 10px 0 18px; }
  .split-text p { color: var(--muted); }
  .split-carousel { border-radius: 14px; overflow: hidden; }

  /* ROOMS */
  .rooms { padding: 96px 0; text-align: center; background: var(--white); }
  .rooms-heading { font-size: 2.2rem; margin: 10px 0 16px; }
  .rooms-text { color: var(--muted); max-width: 56ch; margin: 0 auto 20px; }
  .rooms-features {
    list-style: none; display: flex; flex-wrap: wrap;
    justify-content: center; gap: 10px 28px; margin: 0 auto 44px;
  }
  .rooms-features li { display: flex; align-items: center; gap: 8px; font-size: 0.92rem; color: var(--text); }
  .rooms-features li :global(.icon) { color: var(--pop-dk); flex-shrink: 0; }
  .rooms-cta { margin-top: 44px; }
  .rooms-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 150px;
    grid-auto-flow: dense;
    gap: 16px;
  }
  .gallery-item { position: relative; border-radius: 14px; overflow: hidden; background: #f0e8de; cursor: zoom-in; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s ease; }
  .gallery-item:hover img { transform: scale(1.06); }
  .gallery-item:first-child { grid-column: span 2; grid-row: span 2; }
  .gallery-more-overlay {
    position: absolute; inset: 0;
    background: rgba(20, 15, 10, 0.55);
    display: flex; align-items: center; justify-content: center;
    color: var(--white); font-family: 'Bricolage Grotesque', 'Work Sans', sans-serif;
    font-weight: 700; font-size: 1.3rem; letter-spacing: -0.01em;
    transition: background 0.25s ease;
  }
  .gallery-item:hover .gallery-more-overlay { background: rgba(20, 15, 10, 0.68); }

  /* LIGHTBOX */
  .lightbox {
    display: none;
    position: fixed; inset: 0; z-index: 1000;
    background: rgba(18, 14, 10, 0.92);
    align-items: center; justify-content: center;
    padding: 64px 24px;
  }
  .lightbox.open { display: flex; }
  .lightbox img { max-width: 90vw; max-height: 85vh; border-radius: 10px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  .lightbox-close {
    position: absolute; top: 24px; right: 28px;
    width: 44px; height: 44px; border-radius: 50%;
    background: rgba(255,255,255,0.12); border: none; color: var(--white);
    font-size: 1.8rem; line-height: 1; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .lightbox-close:hover { background: rgba(255,255,255,0.25); }
  .lightbox-prev, .lightbox-next {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 52px; height: 52px; border-radius: 50%;
    background: rgba(255,255,255,0.12); border: none; color: var(--white);
    font-size: 2rem; line-height: 1; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }
  .lightbox-prev:hover, .lightbox-next:hover { background: rgba(255,255,255,0.25); }
  @media (max-width: 640px) {
    .lightbox-prev, .lightbox-next { width: 40px; height: 40px; font-size: 1.5rem; }
    .lightbox-prev { left: 8px; }
    .lightbox-next { right: 8px; }
  }

  /* AMENITIES */
  .amenities { background: var(--bg-main); padding: 96px 32px; text-align: center; }
  .amenities-heading { font-size: 2.2rem; margin: 10px 0 48px; }
  .amenities-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; text-align: left; }
  .amenity-icon { display: block; margin-bottom: 12px; color: var(--pop-dk); }
  .amenity h3 { font-size: 1.15rem; font-weight: 500; margin-bottom: 6px; font-family: 'Work Sans', sans-serif; }
  .amenity p { color: var(--muted); font-size: 0.92rem; }

  /* IKAL RESTO-BAR */
  .ikal-section { padding: 96px 32px; background: var(--white); }
  .ikal-card {
    display: grid; grid-template-columns: 1fr 1.1fr;
    align-items: stretch; min-height: 380px;
    border-radius: 18px; overflow: hidden;
    background: var(--bg-card);
    box-shadow: 0 0 1px rgba(30,45,55,0.08), 0 0 40px rgba(30,45,55,0.18);
  }
  .ikal-image { position: relative; height: 100%; overflow: hidden; }
  .ikal-image :global(.carousel) { position: absolute; inset: 0; height: 100%; }
  .ikal-image :global(.carousel-track) { height: 100%; }
  .ikal-image :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: unset !important; }
  .ikal-text { display: flex; flex-direction: column; justify-content: center; padding: 48px; }
  .ikal-text h2 { font-size: 2rem; margin: 8px 0 16px; }
  .ikal-text p { color: var(--muted); }

  /* LOCATION */
  .location { background: var(--bg-main); padding: 88px 32px; text-align: center; }
  .location-heading { font-size: 2.2rem; margin: 10px 0 36px; }
  .location-pills { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .pill {
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid var(--border); background: var(--bg-card);
    padding: 10px 20px; border-radius: 999px; font-size: 0.88rem; color: var(--text);
  }
  .pill :global(.icon) { color: var(--pop-dk); }

  /* RULES */
  .rules { padding: 96px 32px; max-width: 780px; }
  .rules-heading { font-size: 2.2rem; margin: 10px 0 28px; }
  .rules-list { display: flex; flex-direction: column; gap: 12px; padding-left: 22px; color: var(--muted); }
  .rules-list li { list-style: disc; }
  .rules-contact { margin-top: 32px; font-size: 0.98rem; }
  .rules-whatsapp { color: var(--pop-dk); font-weight: 500; margin-left: 6px; border-bottom: 1px solid var(--pop-dk); }
  .rules-cta { margin-top: 24px; }

  /* CTA */
  .cta-section { position: relative; padding: 140px 32px; text-align: center; background: var(--terracotta); overflow: hidden; }
  .cta-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .cta-overlay { position: absolute; inset: 0; background: rgba(20, 14, 9, 0.6); z-index: 0; }
  .cta-content { position: relative; z-index: 1; color: var(--white); display: flex; flex-direction: column; align-items: center; gap: 26px; }
  .cta-content h2 { font-size: clamp(2rem, 4vw, 2.8rem); max-width: 20ch; }
  .cta-buttons { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }

  @media (max-width: 860px) {
    .intro { padding: 56px 0; }
    .stat { padding: 0 24px; }
    .split-inner { grid-template-columns: 1fr; gap: 36px; }
    .amenities, .location, .rules, .cta-section { padding-left: 20px; padding-right: 20px; }
    .amenities-grid { grid-template-columns: 1fr 1fr; }
    .rooms-gallery { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 160px; }
    .ikal-card { grid-template-columns: 1fr; }
    .ikal-image { min-height: 240px; }
    .ikal-text { padding: 32px 24px; }
  }
  @media (max-width: 560px) {
    .amenities-grid { grid-template-columns: 1fr; }
    .rooms-gallery { grid-template-columns: 1fr; grid-auto-rows: 220px; }
    .gallery-item:first-child { grid-column: span 1; grid-row: span 1; }
    .intro-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
    .stat { padding: 0; border-left: none; }
  }
</style>

<script>
  const lightbox = document.getElementById('rooms-lightbox');
  const lightboxImg = lightbox?.querySelector('img');
  const closeBtn = lightbox?.querySelector('.lightbox-close');
  const prevBtn = lightbox?.querySelector('.lightbox-prev');
  const nextBtn = lightbox?.querySelector('.lightbox-next');
  const galleryEl = document.querySelector('.rooms-gallery');
  const allImages: string[] = JSON.parse(galleryEl?.getAttribute('data-images') || '[]');
  let currentIndex = 0;

  function showImage(index: number) {
    if (!lightboxImg || allImages.length === 0) return;
    currentIndex = ((index % allImages.length) + allImages.length) % allImages.length;
    (lightboxImg as HTMLImageElement).src = allImages[currentIndex];
    (lightboxImg as HTMLImageElement).alt = `Habitaciones y espacios comunes El Caite Hostel ${currentIndex + 1}`;
  }

  function openLightboxAt(index: number) {
    if (!lightbox) return;
    showImage(index);
    lightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.rooms-gallery .gallery-item').forEach((item) => {
    item.addEventListener('click', () => {
      const idx = parseInt(item.getAttribute('data-index') || '0', 10);
      openLightboxAt(idx);
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); showImage(currentIndex - 1); });
  nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); showImage(currentIndex + 1); });
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
    if (e.key === 'ArrowRight') showImage(currentIndex + 1);
  });
</script>
